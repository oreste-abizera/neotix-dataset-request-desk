# Copy to deploy/.env.prod (git-ignored) and fill in. Never commit the real file.

# Public hostname whose DNS A/AAAA record points at this server, e.g. desk.example.com
SITE_ADDRESS=desk.example.com

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# Only for trying the production stack on your own machine (SITE_ADDRESS=localhost):
# HTTP_PORT=8081
# HTTPS_PORT=8443
