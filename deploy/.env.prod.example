# Copy to deploy/.env.prod (git-ignored) and fill in. Never commit the real file.

# Public hostname whose DNS A/AAAA record points at this server, e.g. desk.oreste.dev
SITE_ADDRESS=desk.oreste.dev

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=change-me

# Only for trying the production stack on your own machine (SITE_ADDRESS=localhost):
# HTTP_PORT=8081
# HTTPS_PORT=8443

# Staging: create the demo users from seed/users.json (admin@oreste.dev / admin123, ...) and import
# the sample episodes on every start. These passwords are public in the README: do not use this
# with real data.
# SEED_DEMO_DATA=true
